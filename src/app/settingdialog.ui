  <property name="maximumSize">
   <size>
    <width>520</width>
    <height>800</height>
   </size>
  </property>
  <property name="windowTitle">
   <string>播放器设置</string>
  </property>
  <property name="styleSheet">
   <string notr="true">QDialog {
    background-color: #FFFFFF;
    font-family: 'Microsoft YaHei', 'PingFang SC', 'Segoe UI', sans-serif;
    color: #1F2937;
}

QGroupBox {
    background-color: transparent;
    border: 1px solid #FBCFE8;
    border-radius: 10px;
    margin-top: 14px;
    padding: 14px 14px 12px 14px;
    font-weight: 600;
    color: #1F2937;
    font-size: 13px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 14px;
    padding: 0 8px;
    background-color: #FFFFFF;
    color: #1F2937;
}

QLabel {
    color: #4B5563;
    font-size: 13px;
    background: transparent;
}

QRadioButton {
    color: #374151;
    font-size: 13px;
    spacing: 6px;
    padding: 2px 4px;
}
QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 2px solid #D1D5DB;
    border-radius: 8px;
    background-color: #FFFFFF;
    subcontrol-origin: padding;
}
QRadioButton::indicator:hover { border-color: #F472B6; }
QRadioButton::indicator:checked {
    border-color: #DB2777;
    background-color: #DB2777;
    image: none;
}
QRadioButton::indicator:checked:!enabled {
    border-color: #D1D5DB;
    background-color: #D1D5DB;
}
QRadioButton:disabled { color: #9CA3AF; }

QCheckBox {
    color: #374151;
    font-size: 13px;
    spacing: 6px;
    padding: 2px 0;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 2px solid #D1D5DB;
    border-radius: 8px;
    background-color: #FFFFFF;
    subcontrol-origin: padding;
}
QCheckBox::indicator:hover { border-color: #F472B6; }
QCheckBox::indicator:checked {
    border-color: #DB2777;
    background-color: #DB2777;
    image: none;
}
QCheckBox:disabled { color: #9CA3AF; }

QComboBox {
    background-color: #FFFFFF;
    color: #1F2937;
    border: 1px solid #E5E7EB;
    border-radius: 6px;
    padding: 5px 28px 5px 10px;
    font-size: 13px;
    min-height: 18px;
    selection-background-color: #FDF2F8;
}
QComboBox:hover { border-color: #F472B6; }
QComboBox:focus { border-color: #DB2777; }
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border: none;
    background: transparent;
}
QComboBox::down-arrow {
    image: url(:/SmartPlayer-icon/arrow_down_grey.png);
    width: 12px;
    height: 8px;
    margin-right: 6px;
}
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #1F2937;
    border: 1px solid #FBCFE8;
    border-radius: 6px;
    padding: 4px;
    selection-background-color: #FDF2F8;
    selection-color: #DB2777;
    outline: 0;
}
QComboBox QAbstractItemView::item {
    padding: 6px 10px;
    border-radius: 4px;
    min-height: 18px;
}
QComboBox QAbstractItemView::item:hover {
    background-color: #FCE7F3;
}

QLineEdit {
    background-color: #FFFFFF;
    color: #1F2937;
    border: 1px solid #E5E7EB;
    border-radius: 6px;
    padding: 5px 10px;
    font-size: 12px;
    selection-background-color: #FBCFE8;
    selection-color: #1F2937;
}
QLineEdit:hover { border-color: #F472B6; }
QLineEdit:focus { border-color: #DB2777; }
QLineEdit:read-only {
    background-color: #FFF5F7;
    color: #6B7280;
}

QSlider::groove:horizontal {
    background-color: #FBCFE8;
    height: 4px;
    border-radius: 2px;
}
QSlider::sub-page:horizontal {
    background: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0,
        stop:0 #EC4899, stop:1 #F472B6);
    border-radius: 2px;
}
QSlider::add-page:horizontal {
    background-color: #FBCFE8;
    border-radius: 2px;
}
QSlider::handle:horizontal {
    background-color: #FFFFFF;
    border: 2px solid #DB2777;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}
QSlider::handle:horizontal:hover {
    border-color: #BE185D;
    background-color: #FDF2F8;
}
QSlider::handle:horizontal:pressed {
    background-color: #DB2777;
    border-color: #BE185D;
}

QPushButton {
    background-color: #FFFFFF;
    color: #4B5563;
    border: 1px solid #E5E7EB;
    border-radius: 6px;
    padding: 5px 14px;
    font-size: 12px;
    min-height: 16px;
}
QPushButton:hover {
    background-color: #FFF5F7;
    border-color: #F472B6;
    color: #DB2777;
}
QPushButton:pressed {
    background-color: #FCE7F3;
}
QPushButton:disabled {
    background-color: #F9FAFB;
    color: #9CA3AF;
    border-color: #E5E7EB;
}

QPushButton#confirmBtn {
    background: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0,
        stop:0 #EC4899, stop:1 #F472B6);
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 7px 24px;
    font-size: 13px;
    font-weight: 600;
    min-width: 80px;
    min-height: 18px;
}
QPushButton#confirmBtn:hover {
    background: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0,
        stop:0 #DB2777, stop:1 #BE185D);
}
QPushButton#confirmBtn:pressed {
    background: #BE185D;
}

QPushButton#cancelBtn {
    background-color: #FFFFFF;
    color: #6B7280;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    padding: 7px 24px;
    font-size: 13px;
    min-width: 80px;
    min-height: 18px;
}
QPushButton#cancelBtn:hover {
    background-color: #F9FAFB;
    color: #1F2937;
    border-color: #D1D5DB;
}
QPushButton#cancelBtn:pressed {
    background-color: #F3F4F6;
}

QPushButton#resetConfigBtn {
    background-color: transparent;
    color: #EC4899;
    border: 1px solid #FBCFE8;
    border-radius: 6px;
    padding: 4px 12px;
    font-size: 12px;
    min-height: 16px;
}
QPushButton#resetConfigBtn:hover {
    background-color: #FDF2F8;
    border-color: #F472B6;
    color: #DB2777;
}
QPushButton#resetConfigBtn:pressed {
    background-color: #FCE7F3;
}

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 4px 2px 4px 0;
    border: none;
}
QScrollBar::handle:vertical {
    background: #FBCFE8;
    min-height: 40px;
    border-radius: 4px;
}
QScrollBar::handle:vertical:hover { background: #F472B6; }
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    background: none; border: none; height: 0;
}
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical { background: none; border: none; }
</string>
